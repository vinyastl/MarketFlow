# Server configuration
PORT=5000
NODE_ENV=development

# JWT secret for signing tokens (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_string

# MongoDB connection string
# Leave empty to use the in-memory fallback database (good for quick demos)
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/dbname
# For local MongoDB: mongodb://localhost:27017/mern-ecommerce
MONGODB_URI=

# CORS origin (your frontend URL)
CLIENT_URL=http://localhost:5173
